{
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.html",
      "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
    },
    {
      "source": "**/*.js",
      "headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/product", "destination": "/product.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/orders", "destination": "/orders.html" },
    { "source": "/order-detail", "destination": "/order-detail.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/reset-password", "destination": "/reset-password.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/index", "destination": "/admin/index.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/categories", "destination": "/admin/categories.html" },
    { "source": "/admin/inventory", "destination": "/admin/inventory.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/order-detail", "destination": "/admin/order-detail.html" },
    { "source": "/admin/users", "destination": "/admin/users.html" },
    { "source": "/admin/vouchers", "destination": "/admin/vouchers.html" },
    { "source": "/admin/reviews", "destination": "/admin/reviews.html" }
  ]
}
